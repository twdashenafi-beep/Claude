# DayFlow environment variables
# Copy this file to .env and fill in the values you need. Everything here is
# optional — with no .env at all, DayFlow runs fully offline against encrypted
# local storage.
#
# .env is gitignored. Never commit real keys.

# ── Client (Expo) ───────────────────────────────────────────────────────────
# EXPO_PUBLIC_* variables are inlined into the app bundle and are therefore
# PUBLIC. Only ever put non-secret values here.

# Where the DayFlow API server is reachable. Set this to turn on AI features.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Supabase — encrypted sync across your devices (optional).
# The anon key is designed to be public: Row Level Security scopes rows to the
# signed-in account, and the rows hold only ciphertext. See supabase/schema.sql.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Server (api-server.js) ──────────────────────────────────────────────────
# These stay on the server and are never bundled into the app.

# Anthropic API key, used by the /ai/* endpoints. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

PORT=3001

# The encryption key is derived from your master password on-device.
# It is never stored in an environment variable or sent to any server.
