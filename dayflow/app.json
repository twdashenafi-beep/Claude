{
  "expo": {
    "name": "DayFlow",
    "slug": "dayflow",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tewodros.dayflow",
      "infoPlist": {
        "NSCalendarsUsageDescription": "DayFlow adds a task to your calendar when you choose to put it there.",
        "NSCalendarsFullAccessUsageDescription": "DayFlow adds a task to your calendar when you choose to put it there.",
        "NSMicrophoneUsageDescription": "DayFlow records a voice note when you attach one to a task."
      },
      "requireFullScreen": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tewodros.dayflow",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-calendar",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#007AFF"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "DayFlow records a voice note when you attach one to a task."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DayFlow listens while you hold the microphone, so a task can be written by saying it.",
          "speechRecognitionPermission": "DayFlow turns what you say into the text of a task, on this device."
        }
      ]
    ],
    "scheme": "dayflow",
    "extra": {
      "eas": {
        "projectId": "9ce7b9c9-b773-446f-8005-ba52efdac39b"
      }
    }
  }
}
